# Survey_Production PostgreSQL (survey schema: survey_users, survey_questions, survey_responses)
# Wards/booths live in public schema on the same database.
DATABASE_URL=postgresql://surveyuser:yourpassword@13.233.40.235:5432/surveydb
RUN_DB_MIGRATIONS=false

# AWS S3 — survey audio storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-existing-bucket-name
# Optional: CloudFront or public bucket URL (skips presigned URLs)
# S3_PUBLIC_BASE_URL=https://d1234abcd.cloudfront.net
